# ============================================================
# Gram Vaani – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to git.
# ============================================================

# ---- Azure OpenAI ----------------------------------------
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---- Azure Cognitive Services Speech (TTS + Whisper STT) --
AZURE_SPEECH_KEY=your_azure_speech_service_key_here
AZURE_SPEECH_REGION=eastus

# ---- MongoDB Atlas ----------------------------------------
MONGO_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/gramvani?retryWrites=true&w=majority

# ---- OpenWeatherMap API (free tier available) -------------
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ---- JWT Secret Key (REQUIRED) ---------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_strong_random_secret_key_here_at_least_32_chars

# ---- CORS (optional) -------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Token expiry (optional, default=60 minutes) ---------
ACCESS_TOKEN_EXPIRE_MINUTES=60
